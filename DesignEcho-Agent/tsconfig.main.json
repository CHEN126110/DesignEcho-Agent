{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": ["ES2022", "DOM"],
        "outDir": "./dist/main",
        "rootDir": "./src",
        "strict": true,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "composite": true,
        "baseUrl": ".",
        "paths": {
            "@shared/*": ["src/shared/*"]
        },
        "types": ["node"]
    },
    "include": [
        "src/main/**/*",
        "src/main/**/*.json",
        "src/shared/**/*",
        "src/renderer/services/skill-executors/detail-page.types.ts",
        "src/renderer/services/skill-executors/detail-page-layout-graph.ts",
        "src/renderer/services/skill-executors/detail-page-layout-analyzer.ts",
        "src/renderer/services/skill-executors/detail-page-screen-role.ts"
    ],
    "exclude": ["node_modules"]
}
