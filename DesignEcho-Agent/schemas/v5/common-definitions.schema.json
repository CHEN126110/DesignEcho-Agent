{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://designecho.local/v5/common-definitions.schema.json",
    "title": "DesignEcho v5 共用定义",
    "$defs": {
        "capabilityStatus": {
            "type": "string",
            "enum": ["real", "mock", "fallback", "not_implemented", "blocked_external_dependency", "manual_verification_pending"]
        },
        "artifactProducerUnit": {
            "type": "string",
            "enum": ["R1", "R2", "R3", "R4", "E1", "R5", "E2", "ApprovalService"]
        },
        "artifactRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactId", "artifactType", "contentHash"],
            "properties": {
                "artifactId": { "type": "string", "minLength": 1 },
                "artifactType": { "type": "string", "minLength": 1 },
                "contentHash": { "type": "string", "minLength": 1 }
            }
        },
        "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runtimeUnit", "capabilityStatus"],
            "properties": {
                "runtimeUnit": { "$ref": "#/$defs/artifactProducerUnit" },
                "modelProfile": { "type": "string" },
                "capabilityStatus": { "$ref": "#/$defs/capabilityStatus" }
            }
        },
        "artifactMeta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "artifactId",
                "artifactType",
                "projectId",
                "skillId",
                "sourceRevision",
                "sourceRefs",
                "createdAt",
                "producer",
                "contentHash"
            ],
            "properties": {
                "schemaVersion": { "const": "1.0.0" },
                "artifactId": { "type": "string", "minLength": 1 },
                "artifactType": { "type": "string", "minLength": 1 },
                "projectId": { "type": "string", "minLength": 1 },
                "skillId": { "type": "string", "minLength": 1 },
                "sourceRevision": { "type": "integer", "minimum": 0 },
                "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
                "createdAt": { "type": "string" },
                "producer": { "$ref": "#/$defs/producer" },
                "contentHash": { "type": "string", "pattern": "^sha256-jcs-v1:[0-9a-f]{64}$" }
            }
        },
        "contextFact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factId", "statement", "status", "confidence", "sourceRefs"],
            "properties": {
                "factId": { "type": "string" },
                "statement": { "type": "string" },
                "status": { "type": "string", "enum": ["confirmed", "inferred", "unknown"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "sourceRefs": { "type": "array", "items": { "type": "string" } }
            }
        },
        "assetContext": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetId", "role", "pathRef", "usable", "recommendedUses", "warnings"],
            "properties": {
                "assetId": { "type": "string" },
                "role": { "type": "string", "enum": ["main_product", "detail", "scene", "material", "logo", "reference", "unknown"] },
                "pathRef": { "type": "string" },
                "qualityScore": { "type": "number" },
                "usable": { "type": "boolean" },
                "recommendedUses": { "type": "array", "items": { "type": "string" } },
                "warnings": { "type": "array", "items": { "type": "string" } }
            }
        },
        "missingInput": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputId", "field", "question", "severity"],
            "properties": {
                "inputId": { "type": "string" },
                "field": { "type": "string" },
                "question": { "type": "string" },
                "severity": { "type": "string", "enum": ["blocking", "degradable", "optional"] },
                "defaultPolicy": { "type": "string" }
            }
        },
        "assumption": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assumptionId", "statement", "confidence", "requiresConfirmation"],
            "properties": {
                "assumptionId": { "type": "string" },
                "statement": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "requiresConfirmation": { "type": "boolean" }
            }
        },
        "moduleType": {
            "type": "string",
            "enum": ["hero_kv", "pain_solution", "fabric", "details", "colors", "styling", "parameters", "brand_trust"]
        },
        "modulePriority": {
            "type": "string",
            "enum": ["required", "recommended", "optional"]
        },
        "normalizedRect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            }
        },
        "layoutRegion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["regionId", "role", "bounds", "zIndex", "alignment", "overflow"],
            "properties": {
                "regionId": { "type": "string", "minLength": 1 },
                "role": {
                    "type": "string",
                    "enum": ["primary_visual", "secondary_visual", "headline", "supporting_copy", "tag_cluster", "feature_detail", "parameters", "brand", "decoration"]
                },
                "bounds": { "$ref": "#/$defs/normalizedRect" },
                "zIndex": { "type": "integer", "minimum": 0 },
                "alignment": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["horizontal", "vertical"],
                    "properties": {
                        "horizontal": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
                        "vertical": { "type": "string", "enum": ["start", "center", "end", "stretch"] }
                    }
                },
                "overflow": { "type": "string", "enum": ["clip", "visible"] }
            }
        },
        "elementPlan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["elementId", "role", "elementType", "regionId", "styleTokenRefs", "required"],
            "properties": {
                "elementId": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "enum": ["feature_icon", "badge", "divider", "callout", "background_shape", "decoration"] },
                "elementType": { "type": "string", "enum": ["shape", "icon", "line", "badge", "decoration"] },
                "regionId": { "type": "string", "minLength": 1 },
                "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "refId"],
                    "properties": {
                        "kind": { "type": "string", "enum": ["icon", "asset", "token"] },
                        "refId": { "type": "string" }
                    }
                },
                "styleTokenRefs": { "type": "array", "items": { "type": "string" } },
                "transform": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["anchor", "offsetX", "offsetY", "scale", "rotationDeg"],
                    "properties": {
                        "anchor": { "type": "string", "enum": ["center", "top_left", "top_right", "bottom_left", "bottom_right"] },
                        "offsetX": { "type": "number", "minimum": -1, "maximum": 1 },
                        "offsetY": { "type": "number", "minimum": -1, "maximum": 1 },
                        "scale": { "type": "number", "exclusiveMinimum": 0 },
                        "rotationDeg": { "type": "number", "minimum": -180, "maximum": 180 }
                    }
                },
                "required": { "type": "boolean" }
            }
        },
        "imageSlotPlan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slotId", "role", "placement", "mask"],
            "properties": {
                "slotId": { "type": "string" },
                "role": { "type": "string", "enum": ["main_product", "detail", "background", "material", "scene", "feature_detail"] },
                "assetId": { "type": "string" },
                "placement": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fit", "anchor", "scale", "rotation"],
                    "properties": {
                        "fit": { "type": "string", "enum": ["contain", "cover"] },
                        "anchor": { "type": "string" },
                        "scale": { "type": "number" },
                        "rotation": { "type": "number" },
                        "focalPoint": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["x", "y"],
                            "properties": {
                                "x": { "type": "number" },
                                "y": { "type": "number" }
                            }
                        }
                    }
                },
                "mask": { "type": "string", "enum": ["none", "clipping", "shape"] }
            }
        }
    }
}
