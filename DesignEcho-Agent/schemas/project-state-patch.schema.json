{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-agent.local/schemas/project-state-patch.schema.json",
  "title": "Project State Patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patch_id",
    "project_id",
    "workflow_run_id",
    "owner_id",
    "base_revision",
    "operations",
    "reason",
    "created_at"
  ],
  "properties": {
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_run_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "pattern": "^(R[0-5]|E[1-2]|CAPABILITY_SERVICE)$"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "path"
        ],
        "properties": {
          "op": {
            "enum": [
              "add",
              "replace",
              "remove",
              "test"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {},
          "expected_owner_scope": {
            "type": "string"
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
