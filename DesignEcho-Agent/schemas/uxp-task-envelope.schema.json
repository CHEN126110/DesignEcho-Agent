{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-agent.local/schemas/uxp-task-envelope.schema.json",
  "title": "UXP Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "workflow_run_id",
    "tool_id",
    "target_context",
    "payload",
    "requires_confirmation",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "workflow_run_id": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "target_context": {
      "enum": [
        "read",
        "sandbox",
        "current_document_confirmed"
      ]
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "confirmation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace": {
      "type": "object",
      "properties": {
        "requested_by": {
          "type": "string"
        },
        "project_state_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
