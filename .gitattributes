# Keep source and project memory stable across Windows shells.
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
CODEOWNERS text eol=lf
LICENSE* text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts may keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.psd binary
*.psb binary
*.zip binary
*.7z binary
*.onnx binary
